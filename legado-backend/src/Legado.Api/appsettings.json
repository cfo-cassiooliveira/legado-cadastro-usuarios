{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "Polly": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "LegadoDb": ""
  },
  "Jwt": {
    "Issuer": "legado-api",
    "Audience": "legado-web",
    "SigningKey": "",
    "AccessTokenLifetime": "00:15:00"
  },
  "AddressServices": {
    "ViaCepBaseUrl": "https://viacep.com.br/",
    "IbgeBaseUrl": "https://servicodados.ibge.gov.br/",
    "CitiesCacheDuration": "1.00:00:00"
  },
  "Seed": {
    "Enabled": false
  },
  "Graylog": {
    "Host": "",
    "Port": 12201,
    "Transport": "Tcp"
  }
}
