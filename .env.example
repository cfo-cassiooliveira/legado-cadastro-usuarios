# =====================================================================================
# Variáveis de ambiente do docker-compose (modelo SEM valores reais).
#
#   cp .env.example .env      e preencha os valores no .env
#
# O .env contém segredos: está no .gitignore e no .dockerignore e NUNCA deve ser
# versionado nem enviado em imagens (Art. IV.4). Este arquivo (.env.example) é o único
# versionado e não pode conter valores reais.
# Detalhes de cada variável: README.md, seção "Variáveis de ambiente (.env)".
# =====================================================================================

# --- Banco de dados (SQL Server) ----------------------------------------------------
# Senha do usuário administrador "sa". Usada só pelo container do banco e pelo migrator.
# Política do SQL Server: 8+ caracteres com maiúscula, minúscula, número e símbolo.
# Não use aspas simples/duplas (quebram o script sqlcmd). Gere, por exemplo:
#   echo "Sa$(openssl rand -hex 12)#1"
MSSQL_SA_PASSWORD=

# Senha do login de aplicação "legacy_app" (leitura/escrita, sem DDL), usado pela API.
# Mesmas regras da senha acima; deve ser DIFERENTE da senha do "sa".
APP_DB_PASSWORD=

# --- Autenticação (JWT do legado) -----------------------------------------------------
# Chave simétrica HS256 que assina os tokens. Mínimo 32 caracteres aleatórios; a API não
# sobe sem ela. Trocar a chave invalida todos os tokens emitidos. Gere, por exemplo:
#   openssl rand -base64 48
JWT_SIGNING_KEY=

# --- Massa de demonstração ------------------------------------------------------------
# true: na primeira subida (banco vazio) cria "admin" + 10 usuários fictícios.
SEED_ENABLED=true

# Senha de TODOS os usuários de demonstração. Obrigatória quando SEED_ENABLED=true
# (a API não sobe sem ela). Deve atender à política do Identity:
# 8+ caracteres, maiúscula, minúscula, número e símbolo.
SEED_DEFAULT_PASSWORD=

# --- Ambiente da API ------------------------------------------------------------------
# Production (padrão recomendado) ou Development. Development publica o documento OpenAPI
# em /openapi/v1.json, que só é acessível pela rede interna do Docker.
API_ENVIRONMENT=Production
